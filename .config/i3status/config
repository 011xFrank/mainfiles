general {
    interval        = 5
    colors          = true
    color_good      = '#7f9477'   # sage - soft green, comfortable for "OK" state
    color_degraded  = '#d0b97d'   # warm amber-gold, gently warns without strain
    color_bad       = '#bf616a'   # crimson - subdued red, noticeable but not harsh
}

order += "wireless wlp0s20f3"
order += "ethernet enp0s0"
order += "battery 0"
order += "cpu_usage 0"
order += "cpu_temperature 0"
order += "memory"
order += "volume master"
order += "disk /"
order += "tztime local"

wireless wlp0s20f3 {
    format_up = "W: (%quality at %essid) %ip"
    format_down = "W: down"
}

ethernet enp0s0 {
    # if you use %speed, i3status requires root privileges
    format_up = "%ip (%speed)"
    format_down = ""
}

battery 0 {
    format = "%status %percentage %remaining"
    format_down = ""
    last_full_capacity = true
    integer_battery_capacity = true
    low_threshold = 11
    threshold_type = percentage
    hide_seconds = true
    status_chr = " "
    status_bat = " "
    status_unk = " "
    status_full = " "
}

cpu_usage {
    format = " %usage"
}

cpu_temperature 0 {
    format = " %degrees°C"
}

memory {
    format = " %used"
    threshold_degraded = "10%"
    threshold_critical = "5%"
    unit = "Gi"
}

volume master {
    format = " %volume"
    format_muted = " "
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

disk "/" {
    format = " %avail"
    prefix_type = custom
    low_threshold = 20
    threshold_type = percentage_avail
}

tztime local {
    format = "%e %A %B -  %H:%M:%S"
}
